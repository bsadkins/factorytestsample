          "BuildSpec": "{
  "phases": {
    "install": {
      "runtime-versions": {
        "nodejs": "24",
        "python": "3.12"
      },
      "commands": [
        "python3 -c \\"import sys; assert sys.version_info[:2] == (3, 12), sys.version\\"",
        "python3 -m venv .venv",
        ".venv/bin/python -m pip install --require-hashes -r requirements-dev.txt",
        "npm ci"
      ]
    },
    "build": {
      "commands": [
        "npm run verify",
        "npx cdk synth -c pipeline=true --no-lookups --quiet --output cdk.out/pipeline"
      ]
    }
  },
  "cache": {
    "paths": [
      ".cache/pip/**/*"
    ]
  },
  "version": "0.2",
  "artifacts": {
    "base-directory": "cdk.out/pipeline",
    "files": [
      "**/*"
    ]
  }
}",
