    "ObservabilityRunCompletionAccess9BBEDA54": {
      "Properties": {
        "PolicyDocument": {
          "Statement": [
            {
              "Action": "s3:ListBucket",
              "Condition": {
                "StringLike": {
                  "s3:prefix": [
                    "account-lists/*",
                  ],
                },
              },
              "Effect": "Allow",
              "Resource": {
                "Fn::GetAtt": [
                  "StorageAccountListBucketDB72317C",
                  "Arn",
                ],
              },
              "Sid": "ListAccountLists",
            },
            {
              "Action": "s3:GetObject",
              "Effect": "Allow",
              "Resource": {
                "Fn::Join": [
                  "",
                  [
                    {
                      "Fn::GetAtt": [
                        "StorageAccountListBucketDB72317C",
                        "Arn",
                      ],
                    },
                    "/account-lists/*",
                  ],
                ],
              },
              "Sid": "ReadAccountLists",
            },
            {
              "Action": "s3:ListBucket",
              "Effect": "Allow",
              "Resource": {
                "Fn::GetAtt": [
                  "StorageRawBucketBBD9BDC5",
                  "Arn",
                ],
              },
              "Sid": "ListRawBucket",
            },
            {
              "Action": "s3:GetObject",
              "Effect": "Allow",
              "Resource": {
                "Fn::Join": [
                  "",
                  [
                    {
                      "Fn::GetAtt": [
                        "StorageRawBucketBBD9BDC5",
                        "Arn",
                      ],
                    },
                    "/runs/*",
                  ],
                ],
              },
              "Sid": "ReadRunMarkers",
            },
            {
              "Action": "s3:PutObject",
              "Effect": "Allow",
              "Resource": {
                "Fn::Join": [
                  "",
                  [
                    {
                      "Fn::GetAtt": [
                        "StorageRawBucketBBD9BDC5",
                        "Arn",
                      ],
                    },
                    "/runs/*/completion.json",
                  ],
                ],
              },
              "Sid": "RecordRunCompletion",
            },
            {
              "Action": [
                "s3:GetObject",
                "s3:PutObject",
              ],
              "Effect": "Allow",
              "Resource": {
                "Fn::Join": [
                  "",
                  [
                    {
                      "Fn::GetAtt": [
                        "StorageRawBucketBBD9BDC5",
                        "Arn",
                      ],
                    },
                    "/account_number=*/case_number=*/failure-deliveries/*",
                  ],
                ],
              },
              "Sid": "TrackFailureDeliveries",
            },
            {
              "Action": "states:DescribeExecution",
              "Effect": "Allow",
              "Resource": "arn:aws:states:us-east-1:111111111111:execution:CaseAnalysis-sciprod:*",
              "Sid": "DescribeCaseAnalysis",
            },
            {
              "Action": "sqs:SendMessage",
              "Effect": "Allow",
              "Resource": {
                "Fn::GetAtt": [
                  "QueuesWorkflowFailures66009843",
                  "Arn",
                ],
              },
              "Sid": "SendFailureRecords",
            },
          ],
          "Version": "2012-10-17",
        },
        "PolicyName": "ObservabilityRunCompletionAccess9BBEDA54",
        "Roles": [
          {
            "Ref": "ObservabilityRunCompletionRoleD787B2A4",
          },
        ],
      },
      "Type": "AWS::IAM::Policy",
    },
    "ObservabilityRunCompletionErrorsAlarm059937D3": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "ObservabilityAlarmTopicF724909D",
          },
        ],
        "AlarmDescription": "Run Completion could not reconcile some run markers or executions for three consecutive hours. Runbook: docs/runbook.md#runcompletionerrors",
        "AlarmName": "CaseInsights-sciprod-RunCompletionErrors",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "DatapointsToAlarm": 3,
        "Dimensions": [
          {
            "Name": "service",
            "Value": "run-completion",
          },
        ],
        "EvaluationPeriods": 3,
        "MetricName": "RunCompletionErrors",
        "Namespace": "SupportCaseInsights",
        "Period": 3600,
        "Statistic": "Sum",
        "Tags": [
          {
            "Key": "Environment",
            "Value": "prod",
          },
          {
            "Key": "Project",
            "Value": "SupportCaseInsights",
          },
          {
            "Key": "UniqueId",
            "Value": "sciprod",
          },
        ],
        "Threshold": 1,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "ObservabilityRunCompletionFunctionA18ADCE8": {
      "DependsOn": [
        "ObservabilityRunCompletionRoleD787B2A4",
        "ObservabilityRunCompletionTelemetryPolicyCB8E5DAC",
      ],
      "Properties": {
        "Architectures": [
          "x86_64",
        ],
        "Code": {
          "S3Bucket": "cdk-hnb659fds-assets-111111111111-us-east-1",
          "S3Key": "ASSET_HASH.zip",
        },
        "Description": "Emits the daily heartbeat once a run's accounts and cases are terminal (sciprod)",
        "Environment": {
          "Variables": {
            "ACCOUNT_LIST_BUCKET": {
              "Ref": "StorageAccountListBucketDB72317C",
            },
            "CASE_INSIGHTS_UNIQUE_ID": "sciprod",
            "FAILURE_QUEUE_URL": {
              "Ref": "QueuesWorkflowFailures66009843",
            },
            "MANAGEMENT_ACCOUNT_ID": "111111111111",
            "POWERTOOLS_LOGGER_LOG_EVENT": "false",
            "POWERTOOLS_LOGGER_SAMPLE_RATE": "0",
            "POWERTOOLS_LOG_LEVEL": "INFO",
            "POWERTOOLS_METRICS_NAMESPACE": "SupportCaseInsights",
            "POWERTOOLS_SERVICE_NAME": "run-completion",
            "POWERTOOLS_TRACER_CAPTURE_ERROR": "false",
            "POWERTOOLS_TRACER_CAPTURE_RESPONSE": "false",
            "RAW_BUCKET": {
              "Ref": "StorageRawBucketBBD9BDC5",
            },
            "RUN_LOOKBACK_HOURS": "72",
            "STATE_MACHINE_ARN": {
              "Ref": "CaseAnalysisStateMachine234D35AF",
            },
          },
        },
        "FunctionName": "Lambda-RunCompletion-sciprod",
        "Handler": "app.handler",
        "Layers": [
          {
            "Ref": "SharedLayersCommonLayer7C4E03F5",
          },
        ],
        "LoggingConfig": {
          "LogFormat": "JSON",
          "LogGroup": {
            "Ref": "ObservabilityRunCompletionLogGroup7B5871A4",
          },
        },
        "MemorySize": 512,
        "Role": {
          "Fn::GetAtt": [
            "ObservabilityRunCompletionRoleD787B2A4",
            "Arn",
          ],
        },
        "Runtime": "python3.12",
        "Tags": [
          {
            "Key": "Environment",
            "Value": "prod",
          },
          {
            "Key": "Project",
            "Value": "SupportCaseInsights",
          },
          {
            "Key": "UniqueId",
            "Value": "sciprod",
          },
        ],
        "Timeout": 300,
        "TracingConfig": {
          "Mode": "Active",
        },
      },
      "Type": "AWS::Lambda::Function",
    },
