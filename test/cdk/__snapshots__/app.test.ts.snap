    "ObservabilityFailureDeliveryErrorsAlarm7858FC1E": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "ObservabilityAlarmTopicF724909D",
          },
        ],
        "AlarmDescription": "A failure record could not be written to the workflow failure queue; a pending marker or workflow retry keeps the evidence. Runbook: docs/runbook.md#failuredeliveryerrors",
        "AlarmName": "CaseInsights-scidev-FailureDeliveryErrors",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "DatapointsToAlarm": 1,
        "EvaluationPeriods": 1,
        "Metrics": [
          {
            "Expression": "SUM([FILL(handler, 0), FILL(cleanup, 0), FILL(completion, 0)])",
            "Id": "expr_1",
            "Label": "Failure delivery errors",
            "ReturnData": true,
          },
          {
            "Id": "handler",
            "MetricStat": {
              "Metric": {
                "Dimensions": [
                  {
                    "Name": "service",
                    "Value": "handle-failure",
                  },
                ],
                "MetricName": "WorkflowFailureDeliveryErrors",
                "Namespace": "SupportCaseInsights",
              },
              "Period": 3600,
              "Stat": "Sum",
            },
            "ReturnData": false,
          },
          {
            "Id": "cleanup",
            "MetricStat": {
              "Metric": {
                "Dimensions": [
                  {
                    "Name": "service",
                    "Value": "case-cleanup",
                  },
                ],
                "MetricName": "FailureDeliveryErrors",
                "Namespace": "SupportCaseInsights",
              },
              "Period": 3600,
              "Stat": "Sum",
            },
            "ReturnData": false,
          },
          {
            "Id": "completion",
            "MetricStat": {
              "Metric": {
                "Dimensions": [
                  {
                    "Name": "service",
                    "Value": "run-completion",
                  },
                ],
                "MetricName": "FailureDeliveryErrors",
                "Namespace": "SupportCaseInsights",
              },
              "Period": 3600,
              "Stat": "Sum",
            },
            "ReturnData": false,
          },
        ],
        "Tags": [
          {
            "Key": "Environment",
            "Value": "dev",
          },
          {
            "Key": "Project",
            "Value": "SupportCaseInsights",
          },
          {
            "Key": "UniqueId",
            "Value": "scidev",
          },
        ],
        "Threshold": 1,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
