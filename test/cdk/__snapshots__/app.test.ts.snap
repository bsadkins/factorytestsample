    "ObservabilityAlarmTopicPolicyA9C4040E": {
      "Properties": {
        "PolicyDocument": {
          "Statement": [
            {
              "Action": "sns:Publish",
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false",
                },
              },
              "Effect": "Deny",
              "Principal": "*",
              "Resource": {
                "Ref": "ObservabilityAlarmTopicF724909D",
              },
              "Sid": "AllowPublishThroughSSLOnly",
            },
            {
              "Action": "sns:Publish",
              "Condition": {
                "ArnLike": {
                  "aws:SourceArn": "arn:aws:cloudwatch:us-east-1:111111111111:alarm:CaseInsights-sciprod-*",
                },
                "StringEquals": {
                  "aws:SourceAccount": "111111111111",
                },
              },
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudwatch.amazonaws.com",
              },
              "Resource": {
                "Ref": "ObservabilityAlarmTopicF724909D",
              },
              "Sid": "AllowCloudWatchAlarmsToPublish",
            },
          ],
          "Version": "2012-10-17",
        },
        "Topics": [
          {
            "Ref": "ObservabilityAlarmTopicF724909D",
          },
        ],
      },
      "Type": "AWS::SNS::TopicPolicy",
    },
