    "ObservabilityWorkflowFailuresRecordedAlarmE62357BA": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "ObservabilityAlarmTopicF724909D",
          },
        ],
        "AlarmDescription": "Failure records were written to the workflow failure queue: exhausted or closed CaseAnalysis attempts, or conversations too large to summarise. Runbook: docs/runbook.md#workflowfailuresrecorded",
        "AlarmName": "CaseInsights-scidev-WorkflowFailuresRecorded",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "DatapointsToAlarm": 1,
        "EvaluationPeriods": 1,
        "Metrics": [
          {
            "Expression": "SUM([FILL(handled, 0), FILL(oversized, 0), FILL(cleanup, 0), FILL(completion, 0)])",
            "Id": "expr_1",
            "Label": "Failure records",
            "ReturnData": true,
          },
          {
            "Id": "handled",
            "MetricStat": {
              "Metric": {
                "Dimensions": [
                  {
                    "Name": "service",
                    "Value": "handle-failure",
                  },
                ],
                "MetricName": "WorkflowFailuresRecorded",
                "Namespace": "SupportCaseInsights",
              },
              "Period": 300,
              "Stat": "Sum",
            },
            "ReturnData": false,
          },
          {
            "Id": "oversized",
            "MetricStat": {
              "Metric": {
                "Dimensions": [
                  {
                    "Name": "service",
                    "Value": "case-annotation",
                  },
                ],
                "MetricName": "OversizedConversations",
                "Namespace": "SupportCaseInsights",
              },
              "Period": 300,
              "Stat": "Sum",
            },
            "ReturnData": false,
          },
          {
            "Id": "cleanup",
            "MetricStat": {
              "Metric": {
                "Dimensions": [
                  {
                    "Name": "service",
                    "Value": "case-cleanup",
                  },
                ],
                "MetricName": "FailureDeliveriesSent",
                "Namespace": "SupportCaseInsights",
              },
              "Period": 300,
              "Stat": "Sum",
            },
            "ReturnData": false,
          },
          {
            "Id": "completion",
            "MetricStat": {
              "Metric": {
                "Dimensions": [
                  {
                    "Name": "service",
                    "Value": "run-completion",
                  },
                ],
                "MetricName": "FailureDeliveriesSent",
                "Namespace": "SupportCaseInsights",
              },
              "Period": 300,
              "Stat": "Sum",
            },
            "ReturnData": false,
          },
        ],
        "Tags": [
          {
            "Key": "Environment",
            "Value": "dev",
          },
          {
            "Key": "Project",
            "Value": "SupportCaseInsights",
          },
          {
            "Key": "UniqueId",
            "Value": "scidev",
          },
        ],
        "Threshold": 1,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
