        ],
        "Code": {
          "S3Bucket": "cdk-hnb659fds-assets-111111111111-us-east-1",
          "S3Key": "ASSET_HASH.zip",
        },
        "Description": "Emits the daily heartbeat once a run's accounts and cases are terminal (scidev)",
        "Environment": {
          "Variables": {
            "ACCOUNT_LIST_BUCKET": {
              "Ref": "StorageAccountListBucketDB72317C",
            },
            "CASE_INSIGHTS_UNIQUE_ID": "scidev",
            "FAILURE_QUEUE_URL": {
              "Ref": "QueuesWorkflowFailures66009843",
            },
            "MANAGEMENT_ACCOUNT_ID": "111111111111",
            "POWERTOOLS_LOGGER_LOG_EVENT": "false",
            "POWERTOOLS_LOGGER_SAMPLE_RATE": "0",
            "POWERTOOLS_LOG_LEVEL": "INFO",
            "POWERTOOLS_METRICS_NAMESPACE": "SupportCaseInsights",
            "POWERTOOLS_SERVICE_NAME": "run-completion",
            "POWERTOOLS_TRACER_CAPTURE_ERROR": "false",
            "POWERTOOLS_TRACER_CAPTURE_RESPONSE": "false",
            "RAW_BUCKET": {
              "Ref": "StorageRawBucketBBD9BDC5",
            },
            "RUN_LOOKBACK_HOURS": "72",
            "STATE_MACHINE_ARN": {
              "Ref": "CaseAnalysisStateMachine234D35AF",
            },
          },
        },
        "FunctionName": "Lambda-RunCompletion-scidev",
        "Handler": "app.handler",
        "Layers": [
          {
            "Ref": "SharedLayersCommonLayer7C4E03F5",
          },
        ],
        "LoggingConfig": {
          "LogFormat": "JSON",
          "LogGroup": {
            "Ref": "ObservabilityRunCompletionLogGroup7B5871A4",
          },
        },
        "MemorySize": 512,
        "Role": {
          "Fn::GetAtt": [
            "ObservabilityRunCompletionRoleD787B2A4",
            "Arn",
          ],
        },
        "Runtime": "python3.12",
        "Tags": [
          {
            "Key": "Environment",
            "Value": "dev",
          },
          {
            "Key": "Project",
            "Value": "SupportCaseInsights",
          },
          {
            "Key": "UniqueId",
            "Value": "scidev",
          },
        ],
