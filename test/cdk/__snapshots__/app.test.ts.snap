    "ObservabilityAlarmTopicPolicyA9C4040E": {
      "Properties": {
        "PolicyDocument": {
          "Statement": [
            {
              "Action": "sns:Publish",
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false",
                },
              },
              "Effect": "Deny",
              "Principal": "*",
              "Resource": {
                "Ref": "ObservabilityAlarmTopicF724909D",
              },
              "Sid": "AllowPublishThroughSSLOnly",
            },
            {
              "Action": "sns:Publish",
              "Condition": {
                "ArnLike": {
                  "aws:SourceArn": "arn:aws:cloudwatch:us-east-1:111111111111:alarm:CaseInsights-scidev-*",
                },
                "StringEquals": {
                  "aws:SourceAccount": "111111111111",
                },
              },
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudwatch.amazonaws.com",
              },
              "Resource": {
                "Ref": "ObservabilityAlarmTopicF724909D",
              },
              "Sid": "AllowCloudWatchAlarmsToPublish",
            },
          ],
          "Version": "2012-10-17",
        },
        "Topics": [
          {
            "Ref": "ObservabilityAlarmTopicF724909D",
          },
        ],
      },
      "Type": "AWS::SNS::TopicPolicy",
    },
    "ObservabilityCleanupErrorsAlarm5006E90F": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "ObservabilityAlarmTopicF724909D",
          },
        ],
        "AlarmDescription": "Case Cleanup could not evaluate or reset some cases; they are retried on the next daily run. Runbook: docs/runbook.md#cleanuperrors",
        "AlarmName": "CaseInsights-scidev-CleanupErrors",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "DatapointsToAlarm": 1,
        "Dimensions": [
          {
            "Name": "service",
            "Value": "case-cleanup",
          },
        ],
        "EvaluationPeriods": 1,
        "MetricName": "CleanupErrors",
        "Namespace": "SupportCaseInsights",
        "Period": 3600,
        "Statistic": "Sum",
        "Tags": [
          {
            "Key": "Environment",
            "Value": "dev",
          },
          {
            "Key": "Project",
            "Value": "SupportCaseInsights",
          },
          {
            "Key": "UniqueId",
            "Value": "scidev",
          },
        ],
        "Threshold": 1,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
