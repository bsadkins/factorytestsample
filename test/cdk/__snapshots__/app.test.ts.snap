              },
              "Period": 300,
              "Stat": "Sum",
            },
            "ReturnData": false,
          },
          {
            "Id": "oversized",
            "MetricStat": {
              "Metric": {
                "Dimensions": [
                  {
                    "Name": "service",
                    "Value": "case-annotation",
                  },
                ],
                "MetricName": "OversizedConversations",
                "Namespace": "SupportCaseInsights",
              },
              "Period": 300,
              "Stat": "Sum",
            },
            "ReturnData": false,
          },
          {
            "Id": "cleanup",
            "MetricStat": {
              "Metric": {
                "Dimensions": [
                  {
                    "Name": "service",
                    "Value": "case-cleanup",
                  },
                ],
                "MetricName": "FailureDeliveriesSent",
                "Namespace": "SupportCaseInsights",
              },
              "Period": 300,
              "Stat": "Sum",
            },
            "ReturnData": false,
          },
          {
            "Id": "completion",
            "MetricStat": {
              "Metric": {
                "Dimensions": [
                  {
                    "Name": "service",
                    "Value": "run-completion",
                  },
                ],
                "MetricName": "FailureDeliveriesSent",
                "Namespace": "SupportCaseInsights",
              },
              "Period": 300,
              "Stat": "Sum",
            },
            "ReturnData": false,
          },
        ],
        "Tags": [
          {
            "Key": "Environment",
            "Value": "dev",
