    "ObservabilityRunCompletionAccess9BBEDA54": {
      "Properties": {
        "PolicyDocument": {
          "Statement": [
            {
              "Action": "s3:ListBucket",
              "Condition": {
                "StringLike": {
                  "s3:prefix": [
                    "account-lists/*",
                  ],
                },
              },
              "Effect": "Allow",
              "Resource": {
                "Fn::GetAtt": [
                  "StorageAccountListBucketDB72317C",
                  "Arn",
                ],
              },
              "Sid": "ListAccountLists",
            },
            {
              "Action": "s3:GetObject",
              "Effect": "Allow",
              "Resource": {
                "Fn::Join": [
                  "",
                  [
                    {
                      "Fn::GetAtt": [
                        "StorageAccountListBucketDB72317C",
                        "Arn",
                      ],
                    },
                    "/account-lists/*",
                  ],
                ],
              },
              "Sid": "ReadAccountLists",
            },
            {
              "Action": "s3:ListBucket",
              "Effect": "Allow",
              "Resource": {
                "Fn::GetAtt": [
                  "StorageRawBucketBBD9BDC5",
                  "Arn",
                ],
              },
              "Sid": "ListRawBucket",
            },
            {
              "Action": "s3:GetObject",
              "Effect": "Allow",
              "Resource": {
                "Fn::Join": [
                  "",
                  [
                    {
                      "Fn::GetAtt": [
                        "StorageRawBucketBBD9BDC5",
                        "Arn",
                      ],
                    },
                    "/runs/*",
                  ],
                ],
              },
              "Sid": "ReadRunMarkers",
            },
            {
              "Action": "s3:PutObject",
              "Effect": "Allow",
              "Resource": {
                "Fn::Join": [
                  "",
                  [
                    {
                      "Fn::GetAtt": [
                        "StorageRawBucketBBD9BDC5",
                        "Arn",
                      ],
                    },
                    "/runs/*/completion.json",
                  ],
                ],
              },
              "Sid": "RecordRunCompletion",
            },
            {
              "Action": [
                "s3:GetObject",
                "s3:PutObject",
              ],
              "Effect": "Allow",
              "Resource": {
                "Fn::Join": [
                  "",
                  [
                    {
                      "Fn::GetAtt": [
                        "StorageRawBucketBBD9BDC5",
                        "Arn",
                      ],
                    },
                    "/account_number=*/case_number=*/failure-deliveries/*",
                  ],
                ],
              },
              "Sid": "TrackFailureDeliveries",
            },
            {
              "Action": "states:DescribeExecution",
              "Effect": "Allow",
              "Resource": "arn:aws:states:us-east-1:111111111111:execution:CaseAnalysis-scidev:*",
              "Sid": "DescribeCaseAnalysis",
            },
            {
              "Action": "sqs:SendMessage",
              "Effect": "Allow",
              "Resource": {
                "Fn::GetAtt": [
                  "QueuesWorkflowFailures66009843",
                  "Arn",
                ],
              },
              "Sid": "SendFailureRecords",
            },
          ],
          "Version": "2012-10-17",
        },
        "PolicyName": "ObservabilityRunCompletionAccess9BBEDA54",
        "Roles": [
          {
            "Ref": "ObservabilityRunCompletionRoleD787B2A4",
          },
        ],
      },
      "Type": "AWS::IAM::Policy",
    },
