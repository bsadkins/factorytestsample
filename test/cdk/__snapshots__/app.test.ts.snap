    },
    "ObservabilityRunCompletionScheduleA383E86A": {
      "Properties": {
        "Description": "Hourly Support Case Insights run completion check (sciprod)",
        "FlexibleTimeWindow": {
          "Mode": "OFF",
        },
        "Name": "CaseInsights-RunCompletion-sciprod",
        "ScheduleExpression": "rate(1 hour)",
        "ScheduleExpressionTimezone": "Etc/UTC",
        "State": "ENABLED",
        "Target": {
          "Arn": {
            "Fn::GetAtt": [
              "ObservabilityRunCompletionFunctionA18ADCE8",
              "Arn",
            ],
          },
          "RetryPolicy": {
            "MaximumEventAgeInSeconds": 1800,
            "MaximumRetryAttempts": 2,
          },
          "RoleArn": {
            "Fn::GetAtt": [
              "ObservabilityRunCompletionScheduleRoleFD4ECC1A",
              "Arn",
            ],
          },
        },
      },
      "Type": "AWS::Scheduler::Schedule",
    },
    "ObservabilityRunCompletionScheduleRoleDefaultPolicyBF237ACD": {
      "Properties": {
        "PolicyDocument": {
          "Statement": [
            {
              "Action": "lambda:InvokeFunction",
              "Effect": "Allow",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "ObservabilityRunCompletionFunctionA18ADCE8",
                    "Arn",
                  ],
                },
                {
                  "Fn::Join": [
                    "",
                    [
                      {
                        "Fn::GetAtt": [
                          "ObservabilityRunCompletionFunctionA18ADCE8",
                          "Arn",
                        ],
                      },
                      ":*",
                    ],
                  ],
                },
              ],
            },
          ],
          "Version": "2012-10-17",
        },
        "PolicyName": "ObservabilityRunCompletionScheduleRoleDefaultPolicyBF237ACD",
        "Roles": [
          {
            "Ref": "ObservabilityRunCompletionScheduleRoleFD4ECC1A",
          },
        ],
      },
      "Type": "AWS::IAM::Policy",
    },
    "ObservabilityRunCompletionScheduleRoleFD4ECC1A": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": "111111111111",
                  "aws:SourceArn": "arn:aws:scheduler:us-east-1:111111111111:schedule-group/default",
                },
              },
              "Effect": "Allow",
              "Principal": {
                "Service": "scheduler.amazonaws.com",
              },
            },
          ],
          "Version": "2012-10-17",
        },
        "Description": "EventBridge Scheduler role that invokes Lambda-RunCompletion-sciprod",
        "Tags": [
          {
            "Key": "Environment",
            "Value": "prod",
          },
          {
            "Key": "Project",
            "Value": "SupportCaseInsights",
          },
          {
            "Key": "UniqueId",
            "Value": "sciprod",
          },
        ],
      },
      "Type": "AWS::IAM::Role",
    },
    "ObservabilityRunCompletionTelemetryPolicyCB8E5DAC": {
      "Properties": {
        "PolicyDocument": {
          "Statement": [
            {
              "Action": [
                "logs:CreateLogStream",
                "logs:PutLogEvents",
              ],
              "Effect": "Allow",
              "Resource": {
                "Fn::GetAtt": [
                  "ObservabilityRunCompletionLogGroup7B5871A4",
                  "Arn",
                ],
              },
              "Sid": "WriteOwnLogGroup",
            },
            {
              "Action": [
                "xray:PutTelemetryRecords",
                "xray:PutTraceSegments",
              ],
              "Effect": "Allow",
              "Resource": "*",
              "Sid": "WriteXRaySegments",
            },
          ],
          "Version": "2012-10-17",
        },
        "PolicyName": "ObservabilityRunCompletionTelemetryPolicyCB8E5DAC",
        "Roles": [
          {
            "Ref": "ObservabilityRunCompletionRoleD787B2A4",
          },
        ],
      },
      "Type": "AWS::IAM::Policy",
    },
    "ObservabilityWorkflowExecutionsAbortedAlarm1C500407": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "ObservabilityAlarmTopicF724909D",
          },
        ],
        "AlarmDescription": "CaseAnalysis executions were stopped; reconciliation records their failures. Runbook: docs/runbook.md#workflowexecutionsaborted",
        "AlarmName": "CaseInsights-sciprod-WorkflowExecutionsAborted",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "DatapointsToAlarm": 1,
        "Dimensions": [
          {
            "Name": "StateMachineArn",
            "Value": {
              "Ref": "CaseAnalysisStateMachine234D35AF",
            },
          },
        ],
        "EvaluationPeriods": 1,
        "MetricName": "ExecutionsAborted",
        "Namespace": "AWS/States",
        "Period": 300,
        "Statistic": "Sum",
        "Tags": [
          {
            "Key": "Environment",
            "Value": "prod",
          },
          {
            "Key": "Project",
            "Value": "SupportCaseInsights",
          },
          {
            "Key": "UniqueId",
            "Value": "sciprod",
          },
        ],
        "Threshold": 1,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "ObservabilityWorkflowExecutionsFailedAlarm992955DE": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "ObservabilityAlarmTopicF724909D",
          },
        ],
        "AlarmDescription": "CaseAnalysis executions failed after task retries; each should have a failure record on the workflow failure queue. Runbook: docs/runbook.md#workflowexecutionsfailed",
        "AlarmName": "CaseInsights-sciprod-WorkflowExecutionsFailed",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "DatapointsToAlarm": 1,
        "Dimensions": [
          {
            "Name": "StateMachineArn",
            "Value": {
              "Ref": "CaseAnalysisStateMachine234D35AF",
            },
          },
        ],
        "EvaluationPeriods": 1,
        "MetricName": "ExecutionsFailed",
        "Namespace": "AWS/States",
        "Period": 300,
        "Statistic": "Sum",
        "Tags": [
          {
            "Key": "Environment",
            "Value": "prod",
          },
          {
            "Key": "Project",
            "Value": "SupportCaseInsights",
          },
          {
            "Key": "UniqueId",
            "Value": "sciprod",
          },
        ],
        "Threshold": 1,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "ObservabilityWorkflowExecutionsTimedOutAlarmC142CD0B": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "ObservabilityAlarmTopicF724909D",
          },
        ],
        "AlarmDescription": "CaseAnalysis executions hit the workflow timeout, which bypasses task error handling; reconciliation records their failures. Runbook: docs/runbook.md#workflowexecutionstimedout",
        "AlarmName": "CaseInsights-sciprod-WorkflowExecutionsTimedOut",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "DatapointsToAlarm": 1,
        "Dimensions": [
          {
            "Name": "StateMachineArn",
            "Value": {
              "Ref": "CaseAnalysisStateMachine234D35AF",
            },
          },
        ],
        "EvaluationPeriods": 1,
        "MetricName": "ExecutionsTimedOut",
        "Namespace": "AWS/States",
        "Period": 300,
        "Statistic": "Sum",
        "Tags": [
          {
            "Key": "Environment",
            "Value": "prod",
          },
          {
            "Key": "Project",
            "Value": "SupportCaseInsights",
          },
          {
            "Key": "UniqueId",
            "Value": "sciprod",
          },
        ],
        "Threshold": 1,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "ObservabilityWorkflowFailuresRecordedAlarmE62357BA": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "ObservabilityAlarmTopicF724909D",
          },
        ],
        "AlarmDescription": "Failure records were written to the workflow failure queue: exhausted or closed CaseAnalysis attempts, or conversations too large to summarise. Runbook: docs/runbook.md#workflowfailuresrecorded",
        "AlarmName": "CaseInsights-sciprod-WorkflowFailuresRecorded",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "DatapointsToAlarm": 1,
        "EvaluationPeriods": 1,
        "Metrics": [
          {
            "Expression": "SUM([FILL(handled, 0), FILL(oversized, 0), FILL(cleanup, 0), FILL(completion, 0)])",
            "Id": "expr_1",
            "Label": "Failure records",
            "ReturnData": true,
          },
          {
            "Id": "handled",
            "MetricStat": {
              "Metric": {
                "Dimensions": [
                  {
                    "Name": "service",
                    "Value": "handle-failure",
                  },
                ],
                "MetricName": "WorkflowFailuresRecorded",
                "Namespace": "SupportCaseInsights",
              },
              "Period": 300,
              "Stat": "Sum",
            },
            "ReturnData": false,
          },
          {
            "Id": "oversized",
            "MetricStat": {
              "Metric": {
                "Dimensions": [
                  {
                    "Name": "service",
                    "Value": "case-annotation",
                  },
                ],
                "MetricName": "OversizedConversations",
                "Namespace": "SupportCaseInsights",
              },
              "Period": 300,
              "Stat": "Sum",
            },
            "ReturnData": false,
          },
          {
            "Id": "cleanup",
            "MetricStat": {
              "Metric": {
                "Dimensions": [
                  {
                    "Name": "service",
                    "Value": "case-cleanup",
                  },
                ],
                "MetricName": "FailureDeliveriesSent",
                "Namespace": "SupportCaseInsights",
              },
              "Period": 300,
              "Stat": "Sum",
            },
            "ReturnData": false,
          },
          {
            "Id": "completion",
            "MetricStat": {
              "Metric": {
                "Dimensions": [
                  {
                    "Name": "service",
                    "Value": "run-completion",
                  },
                ],
                "MetricName": "FailureDeliveriesSent",
                "Namespace": "SupportCaseInsights",
              },
              "Period": 300,
              "Stat": "Sum",
            },
            "ReturnData": false,
          },
        ],
        "Tags": [
          {
            "Key": "Environment",
            "Value": "prod",
          },
          {
            "Key": "Project",
            "Value": "SupportCaseInsights",
          },
          {
            "Key": "UniqueId",
            "Value": "sciprod",
          },
        ],
        "Threshold": 1,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
