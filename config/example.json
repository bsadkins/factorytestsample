{
  "$schema": "./schema.json",
  "uniqueId": "sciprod",
  "orgId": "o-exampleorg1",
  "managementAccountId": "111111111111",
  "region": "us-east-1",
  "environment": "prod",
  "enableAnalytics": true,
  "enableMcp": false,
  "memberRoleTargets": ["r-ab12"],
  "bedrockModelId": "global.anthropic.claude-haiku-4-5-20251001-v1:0",
  "bedrockMaxTokens": 1000,
  "bedrockMaxConcurrency": 5,
  "lookbackMonths": 12,
  "rawRetentionDays": 90,
  "logRetentionDays": 90,
  "alarmEmail": "case-insights-alerts@example.com",
  "mcpAllowedPrincipals": [],
  "apiGatewayLogging": {
    "mode": "managed",
    "sharedId": "scishared"
  },
  "schedules": {
    "accountLookup": "cron(0 0 * * ? *)",
    "cleanup": "cron(0 22 * * ? *)",
    "crawler": "cron(0 9 * * ? *)"
  },
  "operations": {
    "queues": {
      "maxReceiveCount": 3,
      "dlqRetentionDays": 14
    },
    "functions": {
      "consumerTimeoutSeconds": 300,
      "analysisTimeoutSeconds": 180,
      "memorySizeMb": 512
    },
    "workflow": {
      "executionTimeoutMinutes": 60,
      "starterMaxConcurrency": 2,
      "taskMaxAttempts": 3
    },
    "cleanup": {
      "graceHours": 24
    },
    "storage": {
      "processedInfrequentAccessDays": 90,
      "noncurrentVersionRetentionDays": 30,
      "accessLogRetentionDays": 365
    },
    "athena": {
      "bytesScannedCutoffPerQuery": 10737418240,
      "resultsRetentionDays": 30
    },
    "mcp": {
      "reservedConcurrency": 20,
      "throttleRateLimit": 10,
      "throttleBurstLimit": 20,
      "wafRateLimitPer5Minutes": 300
    }
  }
}
